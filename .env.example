# Backend Configuration
PORT=5000
NODE_ENV=development
CORS_ORIGIN=*

# Version update response
APP_VERSION=1.0.2
APP_VERSION_CODE=3
APK_DOWNLOAD_URL=https://drive.google.com/uc?export=download&id=YOUR_APK_ID
RELEASE_NOTES=Bug fixes and improvements

# Remote app disable control
# Set APP_ENABLED=false to show the app disabled screen in installed apps.
APP_ENABLED=true
APP_ENABLED_MESSAGE=App is available.
APP_DISABLED_MESSAGE=This app is currently disabled. Please try again later.
APP_CONTROL_UPDATED_AT=
